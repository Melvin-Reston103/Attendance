{
  "name": "attendance-backend",
  "version": "1.0.0",
  "description": "REST API backend for the Attendance system, backed by SQLite.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/db/schema.sql', 'dist/db/schema.sql')\"",
    "start": "node dist/index.js"
  },
  "private": true,
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
